---
import Base from "@/layouts/Base.astro";
import { HomeHero } from "@/components/home/HomeHero";
import { ZipLookup } from "@/components/home/ZipLookup";
import { WhyYouCare } from "@/components/home/WhyYouCare";
import { WhereIsland } from "@/components/home/WhereIsland";
import { WhoIsInCharge } from "@/components/home/WhoIsInCharge";
import { LaraEra } from "@/components/home/LaraEra";
import { KimEra } from "@/components/home/KimEra";
import {
  loadCountyDataServer,
  loadPromiseStatsServer,
  loadSiteStatsServer,
  loadStatewideHistoryServer,
} from "@/lib/loadData.server";
import {
  buildHomeStats,
  fmtLongDate,
  loadDistressedCounties,
  pickDefaultZip,
} from "@/lib/homeStats";
import { fmtPolicies } from "@/lib/historyFormat";

const siteStats = loadSiteStatsServer();
const countyData = loadCountyDataServer();
const history = loadStatewideHistoryServer();
const promise = loadPromiseStatsServer();
const stats = buildHomeStats(history);
const distressed = loadDistressedCounties();
const asOf = fmtLongDate(stats.latest.coverage_end);
const defaultZip = pickDefaultZip(distressed.counties);

const description = `California's insurer of last resort holds ${fmtPolicies(stats.latest.policy_count)} home policies, ${stats.sinceFirstMultiple.toFixed(1)} times what it held in 2019. What that costs homeowners, what eight years of regulation produced, and how the next term will be scored.`;
---

<Base description={description}>
  <Fragment slot="head-extra">
    <script is:inline>
      // Legacy redirect: pre-router URLs used ?page=data. Static hosting
      // means this can't be server-side, so it runs inline in <head>.
      (function () {
        if (!window.location.search) return;
        var params = new URLSearchParams(window.location.search);
        if (params.get("page") !== "data") return;
        params.delete("page");
        var q = params.toString();
        window.location.replace("/data" + (q ? "?" + q : ""));
      })();
    </script>
  </Fragment>
  <HomeHero stats={stats} />
  <WhyYouCare stats={stats} />
  <WhereIsland countyData={countyData} stats={siteStats} client:visible />
  <ZipLookup
    initial={defaultZip}
    distressedCounties={distressed.counties}
    asOf={asOf}
    client:visible
  />
  <WhoIsInCharge />
  <LaraEra stats={stats} promise={promise} history={history} />
  <KimEra stats={stats} promise={promise} />
  <section class="bg-white py-10">
    <div class="mx-auto max-w-5xl px-4 text-sm text-gray-600 sm:px-6 lg:px-8">
      <p>
        <a href="/take-action" class="font-semibold text-patriot-red underline">
          What you can do about it →
        </a>
      </p>
      <p class="mt-4 border-t border-gray-200 pt-4">
        FAIR Plan figures on this page are current through {asOf} and come from
        the Plan's published ZIP-level files. Market-wide figures come from the
        California Department of Insurance and end in 2023. This site is an
        independent project and is not affiliated with the FAIR Plan, the
        Department, or any insurer.
      </p>
    </div>
  </section>
</Base>
