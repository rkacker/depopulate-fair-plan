---
import Base from "@/layouts/Base.astro";
import { Ab69Ab1680Memo } from "@/components/sections/Ab69Ab1680Memo";
import {
  loadPromiseStatsServer,
  loadStatewideHistoryServer,
} from "@/lib/loadData.server";

const title = "AB 69 & AB 1680: FAIR Plan Oversight Needs FAIR Plan Data — Depopulate the FAIR Plan";
const description =
  "Asm. Calderon's package strengthens FAIR Plan reporting and oversight. The reporting details that decide whether the public can see what the Plan is actually doing.";

const history = loadStatewideHistoryServer();
const stats = loadPromiseStatsServer();
---

<Base title={title} description={description}>
  {/* Static memo — no client directive, zero JS shipped. */}
  <Ab69Ab1680Memo history={history} stats={stats} />
</Base>
