---
import Base from "@/layouts/Base.astro";
import { Sb1301Memo } from "@/components/sections/Sb1301Memo";
import {
  loadPromiseStatsServer,
  loadStatewideHistoryServer,
} from "@/lib/loadData.server";

const title = "SB 1301: Nonrenewal Protections Need Nonrenewal Data — Depopulate the FAIR Plan";
const description =
  "Sen. Allen's nonrenewal protections will be hard to verify with today's public data. The concrete reporting that would make SB 1301 verifiable.";

const history = loadStatewideHistoryServer();
const stats = loadPromiseStatsServer();
---

<Base title={title} description={description}>
  {/* Static memo — no client directive, zero JS shipped. */}
  <Sb1301Memo history={history} stats={stats} />
</Base>
