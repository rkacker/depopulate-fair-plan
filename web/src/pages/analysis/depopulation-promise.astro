---
import Base from "@/layouts/Base.astro";
import { DepopulationPromise } from "@/components/sections/DepopulationPromise";
import {
  loadPromiseStatsServer,
  loadStatewideHistoryServer,
} from "@/lib/loadData.server";

const title = "The Depopulation Promise — Depopulate the FAIR Plan";
const description =
  "California's 2023 insurer deal promised to shrink the FAIR Plan. The state's own data shows enrollment grew in 93% of the ZIP codes the state designated as distressed.";

const history = loadStatewideHistoryServer();
const stats = loadPromiseStatsServer();
---

<Base title={title} description={description}>
  {/* Static article — no client directive, zero JS shipped. */}
  <DepopulationPromise history={history} stats={stats} />
</Base>
