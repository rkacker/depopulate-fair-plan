---
import Base from "@/layouts/Base.astro";
import { PIECES as pieces, STEPS } from "@/lib/pieces";

const title = "Analysis | Depopulate the FAIR Plan";
const description =
  "The analysis behind the site's scorecards, filed by commissioner's term: the depopulation promise, and the reporting California's insurance laws need.";

---

<Base title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-patriot-red">
      Analysis
    </p>
    <h1 class="mb-4 text-4xl font-bold leading-tight text-charcoal lg:text-5xl">
      The evidence behind the scorecards
    </h1>
    <p class="mb-10 text-lg text-gray-600">
      Long-form analysis built on the FAIR Plan's and the Department of
      Insurance's own published data, filed under the commissioner's term it
      examines. Every figure is reproducible from the datasets on
      <a href="/data" class="underline">Data &amp; Downloads</a>.
    </p>
    {
      STEPS.map((step) => {
        const items = pieces.filter((p) => p.step === step.id);
        return (
          <div class="mb-12">
            <h2 class="mb-5 text-sm font-semibold uppercase tracking-wide text-gray-500">
              <a href={step.home} class="hover:underline">{step.label}</a>
            </h2>
            {items.length === 0 ? (
              <p class="text-gray-600">{step.empty}</p>
            ) : (
              <ul class="space-y-8">
                {items.map((p) => (
                  <li class="border-l-4 border-patriot-red pl-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                      {p.date}
                    </p>
                    <h3 class="mt-1 text-2xl font-bold text-charcoal">
                      <a href={p.href} class="hover:underline">{p.title}</a>
                    </h3>
                    <p class="mt-2 leading-relaxed text-gray-600">{p.dek}</p>
                    <a href={p.href} class="mt-2 inline-block font-semibold text-patriot-red hover:underline">
                      Read →
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })
    }
  </section>
</Base>
